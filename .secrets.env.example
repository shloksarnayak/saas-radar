# Copy to .secrets.env in this same folder, fill in real values, then run:
#   ./setup_secrets.sh
# This pushes every value below as a GitHub Actions secret on the saas-radar repo
# in one shot (instead of the GitHub web UI, 6 separate form submissions) and
# triggers the first workflow run. .secrets.env is gitignored — never commit it.

# github.com/settings/tokens/new -> scopes: repo, workflow (used to push these
# secrets and trigger the first run; safe to revoke after setup_secrets.sh runs)
GH_TOKEN=

# aistudio.google.com/apikey -> Create API Key (needs billing enabled on the
# Google Cloud project for paid-tier usage; supports Indian payment methods
# unlike Anthropic's console)
GEMINI_API_KEY=

# No Reddit credentials needed -- the collector uses public read-only endpoints.

# myaccount.google.com/apppasswords (needs 2FA enabled on the Google account)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# where the daily digest email should be sent (can be the same as GMAIL_ADDRESS)
DIGEST_TO_ADDRESS=

# OPTIONAL, extra source. api.producthunt.com/v2/oauth/applications -> create
# app -> generate a "Developer Token" directly on the app page (no approval
# wait). Leave blank to skip Product Hunt entirely -- everything else still
# works fine without it.
PRODUCTHUNT_TOKEN=
